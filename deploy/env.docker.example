# MCSerAuth Docker 部署最小环境变量示例。
# 复制为 docker-compose.yml 同目录的 .env 后按需修改；完整清单见 docs/deploy.md 第 3 节。
# 注意：compose 会把它注入容器进程，浏览器端与启动器看到的是 APP_URL/AUTH_URL 本身。

# ─── 必填（生产启动强校验）───────────────────────────────────────────────
# 站点与认证服务的公网 origin。单域部署两者相同；分域时必须在同一注册域下
# （Cookie SameSite=Lax 按站点判定，见 docs/deploy.md 第 1 节）。
APP_URL=https://mcserauth.example.com
AUTH_URL=https://mcserauth.example.com
# 生产必须 true；若宿主机反代终止 TLS，这里仍是 true（Cookie 需要 Secure 属性）
COOKIE_SECURE=true
# 会话密钥：>= 32 字符随机串，生成方式：openssl rand -base64 48
BETTER_AUTH_SECRET=替换成 openssl rand -base64 48 的输出

# ─── 数据库（不填则用容器卷内的 SQLite）─────────────────────────────────
# DATABASE_URL=postgres://mcserauth:密码@host:5432/mcserauth

# ─── 邮件（不填则验证/重置邮件只写服务端日志，不投递）────────────────────
# MAIL_PROVIDER=smtp
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=SMTP密码

# ─── 可选：根控制台（/console 的独立密钥登录，用于授予管理员）───────────
# CONSOLE_KEY=替换成 >= 16 字符的随机串

# 可选：站点公网地址（影响 sitemap/robots 生成，默认 http://localhost:3000）
# NEXT_PUBLIC_SITE_URL=https://mcserauth.example.com
