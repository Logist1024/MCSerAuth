# ---------------------------------------------------------------------------
# MCSerAuth server environment (copy to apps/server/.env)
#
#   cp .env.example apps/server/.env
#
# Every variable is validated at boot by apps/server/src/config/env.ts.
# Values below are safe local-development defaults; production MUST override
# BETTER_AUTH_SECRET / AUTH_URL / APP_URL and set COOKIE_SECURE=true.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Public URLs — domain split is intentional (T2): site vs auth service.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:8000

# Cookie policy: local dev false, production must be true (enforced at boot).
COOKIE_SECURE=false

# better-auth secret. REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-please-32

# Launcher OAuth lifetimes (seconds).
# Access tokens default to 30 days (planning baseline); refresh tokens are
# valid for 60 days from the initial authorization and rotate on every use.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=2592000
OAUTH_REFRESH_TOKEN_TTL_SECONDS=5184000
# Authorization codes are single-use and short-lived.
OAUTH_AUTH_CODE_TTL_SECONDS=300

# joinServer registrations stay redeemable by hasJoined for this long (seconds).
SESSION_JOIN_TTL_SECONDS=300
# Signed texture URL lifetime (seconds); launchers/servers re-fetch profiles.
TEXTURE_URL_TTL_SECONDS=300

# Database. The dialect is inferred from the URL scheme, so switching between
# SQLite (default), MySQL 8.0+ and PostgreSQL 16+ only requires changing this
# one line. Relative SQLite paths resolve from apps/server.
#
#   ./data/mcserauth.db           SQLite (default, zero-config local dev)
#   sqlite:./data/mcserauth.db    SQLite (explicit)
#   mysql://user:pass@host:3306/mcserauth
#   postgres://user:pass@host:5432/mcserauth
DATABASE_URL=./data/mcserauth.db
# Optional explicit dialect. Must match DATABASE_URL when both are set; leave
# unset in normal use.
# DB_DIALECT=sqlite
# Connection pool for MySQL/PostgreSQL (ignored by SQLite).
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# Require TLS for MySQL/PostgreSQL connections.
DB_SSL=false

# ---------------------------------------------------------------------------
# Test / migration helpers (not read by the server process itself)
# ---------------------------------------------------------------------------
# Leave unset to run the server test suite against a throwaway SQLite file.
# Point at MySQL/PostgreSQL to run the same suite against a real server. Each
# test file creates and drops its own database, so the account needs CREATE
# and DROP privileges.
# TEST_DATABASE_URL=mysql://root:root@127.0.0.1:3306/mcserauth_test
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mcserauth_test

# One-off SQLite -> MySQL/PostgreSQL copy (`pnpm db:copy-data`).
# SOURCE_DATABASE_URL=./data/mcserauth.db
# TARGET_DATABASE_URL=mysql://user:pass@host:3306/mcserauth

# Local texture/attachment storage (relative paths resolve from apps/server).
UPLOAD_DIR=./data/uploads

# Mail defaults; the root console can override them (SMTP password is
# encrypted at rest with BETTER_AUTH_SECRET).
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Root console (key-only login at /console). Leave CONSOLE_KEY empty to disable.
# Generate with: openssl rand -base64 32
CONSOLE_KEY=
CONSOLE_SESSION_TTL_SECONDS=28800
