# ---------------------------------------------------------------------------
# MCSerAuth server environment (copy to apps/server/.env)
#
#   cp .env.example apps/server/.env
#
# Every variable is validated at boot by apps/server/src/config/env.ts.
# Values below are safe local-development defaults; production MUST override
# BETTER_AUTH_SECRET / AUTH_URL / APP_URL and set COOKIE_SECURE=true.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Public URLs — domain split is intentional (T2): site vs auth service.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:8000

# Cookie policy: local dev false, production must be true (enforced at boot).
COOKIE_SECURE=false

# better-auth secret. REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-please-32

# Launcher OAuth lifetimes (seconds).
# Access tokens default to 30 days (planning baseline); refresh tokens are
# valid for 60 days from the initial authorization and rotate on every use.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=2592000
OAUTH_REFRESH_TOKEN_TTL_SECONDS=5184000
# Authorization codes are single-use and short-lived.
OAUTH_AUTH_CODE_TTL_SECONDS=300

# joinServer registrations stay redeemable by hasJoined for this long (seconds).
SESSION_JOIN_TTL_SECONDS=300
# Signed texture URL lifetime (seconds); launchers/servers re-fetch profiles.
TEXTURE_URL_TTL_SECONDS=300

# SQLite database file (relative paths resolve from apps/server).
DATABASE_URL=./data/mcserauth.db

# Local texture/attachment storage (relative paths resolve from apps/server).
UPLOAD_DIR=./data/uploads

# Mail defaults; the root console can override them (SMTP password is
# encrypted at rest with BETTER_AUTH_SECRET).
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Root console (key-only login at /console). Leave CONSOLE_KEY empty to disable.
# Generate with: openssl rand -base64 32
CONSOLE_KEY=
CONSOLE_SESSION_TTL_SECONDS=28800
