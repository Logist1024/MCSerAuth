        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthDataDto"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "健康检查",
        "tags": [
          "ops"
        ]
      }
    },
