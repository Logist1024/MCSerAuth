  "info": {
    "title": "MCSerAuth API",
    "description": "MCSerAuth 后端 API（M0 底座）。\n\n**统一响应**：非协议端点成功返回 `{ code: 0, data }`，失败返回 `{ code, message }`（错误码见 packages/shared）。\n\n**例外**：`Commons-Designs` 协议端点（OAuth / Session / Profiles / Textures）返回协议原生结构，失败为 `{ error, errorMessage }`，不套统一封装。\n\n**M0 状态**：协议端点均为 stub；标有 “M1/M2 目标响应” 的结构是待实现契约，正与官方协议文档逐条核对（docs/protocol-checklist.md）。",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "ops",
      "description": "运维与健康检查"
    },
    {
      "name": "Commons-Designs / OAuth",
      "description": "账户与授权（协议原生响应）"
    },
    {
      "name": "Commons-Designs / Session",
      "description": "MC 会话服务（协议原生响应）"
    },
    {
      "name": "Commons-Designs / User",
      "description": "用户档案（协议原生响应）"
    },
    {
      "name": "Commons-Designs / Profiles",
      "description": "玩家档案查询（协议原生响应）"
    },
    {
      "name": "Commons-Designs / Textures",
      "description": "皮肤/披风（协议原生响应）"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "当前认证服务地址"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "网站会话（better-auth，M1 前端登录后由浏览器携带）"
      },
      "launcher-token": {
        "scheme": "bearer",
        "bearerFormat": "AccessToken",
        "type": "http"
      }
    },
    "schemas": {
      "OAuthAvailabilityResponseDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean",
            "example": true,
            "description": "M0: 服务可达即为 true"
          }
        },
        "required": [
          "available"
        ]
      },
      "OAuthAuthenticateRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "code_verifier": {
            "type": "string"
          }
        }
      },
      "OAuthUserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "mod",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "OAuthTokenResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expires_in": {
            "type": "number",
            "example": 2592000
          },
          "refresh_token": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/OAuthUserSummaryDto"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token"
        ]
      },
      "ProtocolErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "NotImplementedException"
          },
          "errorMessage": {
            "type": "string",
            "example": "M0 stub"
          },
          "cause": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "errorMessage"
        ]
      },
      "OAuthRefreshRequestDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "UserPlayerSummaryDto": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "banned": {
            "type": "boolean"
          }
        },
        "required": [
          "uuid",
          "nickname",
          "banned"
        ]
      },
      "UserProfilesMeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/OAuthUserSummaryDto"
          },
          "player": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserPlayerSummaryDto"
              }
            ]
          }
        },
        "required": [
          "user",
          "player"
        ]
      },
      "JoinServerRequestDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "启动器访问令牌"
          },
          "selectedProfile": {
            "type": "string",
