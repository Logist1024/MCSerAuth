{
  "name": "mcserauth",
  "version": "1.0.0",
  "private": true,
  "description": "MCSerAuth — integrated forum and external login authentication system for third-party Minecraft: Java Edition servers",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mcserauth/shared build && concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @mcserauth/server dev\" \"pnpm --filter @mcserauth/web dev\"",
    "dev:shared": "pnpm --filter @mcserauth/shared dev",
    "build": "pnpm --filter @mcserauth/shared build && pnpm --filter @mcserauth/server build && pnpm --filter @mcserauth/web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @mcserauth/shared build && pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "db:generate": "pnpm --filter @mcserauth/server db:generate:all",
    "db:generate:sqlite": "pnpm --filter @mcserauth/server db:generate",
    "db:generate:schemas": "pnpm --filter @mcserauth/server db:generate:schemas",
    "db:check": "pnpm db:generate && git diff --exit-code -- apps/server/src/db/schema apps/server/drizzle",
    "db:migrate": "pnpm --filter @mcserauth/server db:migrate",
    "db:copy-data": "pnpm --filter @mcserauth/server db:copy-data",
    "db:seed": "pnpm --filter @mcserauth/server db:seed",
    "db:backup": "pnpm --filter @mcserauth/server db:backup",
    "db:studio": "pnpm --filter @mcserauth/server db:studio",
    "admin:grant": "pnpm --filter @mcserauth/server admin:grant",
    "openapi:export": "pnpm --filter @mcserauth/server openapi:export",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "multer": "^2.5.0"
    }
  }
}
