# Copy to apps/web/.env.local when the API is not on the default local port.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public site origin used by sitemap/robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias path that rewrites to the root console. Setting CONSOLE_PATH=/panel
# serves the console at /panel as well; /console keeps working either way.
# Read when the web app builds/starts (build-time inlining applies).
CONSOLE_PATH=/console
