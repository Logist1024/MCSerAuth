{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node", "multer"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.sqlite.ts",
    "drizzle.config.mysql.ts",
    "drizzle.config.postgres.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "drizzle"]
}
