{
  "name": "@mcserauth/server",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend: forum, better-auth accounts and Commons-Designs authentication protocol",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate:schemas": "tsx scripts/generate-schema.ts",
    "db:generate": "pnpm db:generate:schemas && drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:generate:mysql": "pnpm db:generate:schemas && drizzle-kit generate --config drizzle.config.mysql.ts",
    "db:generate:postgres": "pnpm db:generate:schemas && drizzle-kit generate --config drizzle.config.postgres.ts",
    "db:generate:all": "pnpm db:generate:schemas && drizzle-kit generate --config drizzle.config.sqlite.ts && drizzle-kit generate --config drizzle.config.mysql.ts && drizzle-kit generate --config drizzle.config.postgres.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:copy-data": "tsx scripts/copy-data.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.sqlite.ts",
    "admin:grant": "tsx scripts/grant-role.ts",
    "openapi:export": "nest build && node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@mcserauth/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
